PORT=8090
HOST=127.0.0.1
# Origine del frontend ammessa dal CORS. In produzione: https://tuo-dominio
CORS_ORIGIN=http://localhost:5173
# Solo in produzione, dietro un reverse proxy FIDATO (Caddy/nginx): il nome
# dell'header con l'IP reale del client, per il rate limiter. In locale lascialo vuoto.
# TRUST_PROXY_HEADER=x-forwarded-for

# OBBLIGATORIO: stesso segreto del backend (neurodesk.jwt.secret in
# application.properties). Serve a verificare il token: senza, l'endpoint AI
# risponde 503 (fail-closed) e nessuno puo' bruciare crediti.
JWT_SECRET=

# Provider AI di default: mock | openai | anthropic
# mock = demo locale senza chiavi e senza costi (default)
# L'override per-richiesta col campo "provider" nel body e' consentito SOLO
# all'admin SCUOLA (per le prove A/B). I tester usano sempre questo default.
AI_PROVIDER=mock

# Timeout (ms) della chiamata al provider AI. Oltre questo tempo la richiesta
# viene abbandonata e l'utente riceve un errore onesto invece di uno spinner
# infinito. Sugli errori transitori (429, 529, 5xx) c'e' UN solo ritentativo.
AI_TIMEOUT_MS=30000

# OpenAI (usato se AI_PROVIDER=openai o provider="openai" nella richiesta)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=1024

# Anthropic / Claude Haiku (usato se AI_PROVIDER=anthropic o provider="anthropic")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024
