# NeuroDesk — configurazione di Caddy. MODELLO: i ${...} li sostituisce
# 01-prepara-server.sh.
#
# Questo file e' la FONTE UNICA. Prima viveva dentro un heredoc nello script di
# preparazione, e infatti aveva divergiato: le trappole dell'honeypot e il log
# degli accessi erano stati aggiunti solo al file vivo sul server. Un server
# ricostruito da zero sarebbe nato senza. Ora si modifica qui, e lo script lo
# copia.

{
    email ${EMAIL_TLS}
}

# Percorsi che nessun visitatore vero chiede mai: chi li cerca sta scansionando.
# Definiti una volta e usati su entrambi i domini.
(trappole) {
    # QUALUNQUE percorso che inizia con un punto. Regola larga apposta: la lista
    # puntuale non bastava — uno scanner ha chiesto /.gitconfig, /.github/,
    # /.git-credentials e /.gitlab-ci.yml, che non c'erano, e si e' preso un 200
    # (la pagina dell'app, per il ripiego della single-page). Non aveva ottenuto
    # niente, ma un 200 gli dice "questo percorso esiste", ed e' il segnale
    # sbagliato. Nessuna rotta legittima dell'app inizia con un punto.
    #
    # /.well-known/ resta fuori: serve ai certificati HTTPS.
    @trappola {
        not path /.well-known/*
        path /.* /wp-admin* /wp-login.php /xmlrpc.php /wordpress* /phpmyadmin* /pma* /.env /.env.* /.git /.git/* /.aws/* /.ssh/* /admin /admin/* /administrator* /server-status /server-info /cgi-bin/* /vendor/* /config.php /shell* /debug /solr* /actuator /actuator/* /_ignition/* /autodiscover/*
    }
    handle @trappola {
        # 404 secco e uguale per tutti: non confermiamo niente, non offriamo
        # niente da leggere, e la richiesta resta comunque nel log degli accessi
        # — che e' il punto: l'honeypot osserva, non punisce.
        respond 404
    }
}

# 1) Landing pubblica: file statici, piu' UN SOLO endpoint dinamico (il form contatti).
${DOMINIO} {
    encode gzip
    root * /var/www/neurodesk-landing

    # Log degli accessi: prima non esisteva, quindi di chi bussava e cosa cercava
    # non restava traccia da nessuna parte. E' la materia prima dell'honeypot.
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 5
            # A TEMPO, non solo a dimensione. Con poco traffico la sola soglia
            # sui megabyte avrebbe conservato mesi di log: e qui dentro le URI
            # contengono identificativi di risorsa (/api/companion-sessions/11),
            # cioe' la cronologia di quale conversazione e' stata riaperta e
            # quando. La conservazione E' la misura di privacy, non un dettaglio
            # operativo. Nell'archivio dell'honeypot quelle URI sono gia'
            # normalizzate; qui restano in chiaro, quindi scadono prima.
            roll_keep_for 336h
        }
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
    }
    header /assets/* Cache-Control "no-cache"

    import trappole

    # L'unica eccezione al "solo file statici": il form contatti, che e' anche il
    # modo in cui ci si candida come tester. Senza questa riga il form risponde
    # 404 e rimanda a scrivere una mail, cioe' esattamente il mailto che il form
    # doveva togliere di mezzo. Solo questo percorso: tutto il resto di /api
    # sulla landing continua a non esistere.
    handle /api/public/contact {
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        file_server
    }
}

# 2) www -> dominio nudo, per non avere due indirizzi che rispondono uguale.
www.${DOMINIO} {
    redir https://${DOMINIO}{uri} permanent
}

# 3) Applicazione. L'ordine conta: il companion PRIMA del backend,
#    altrimenti /api/companion/* finirebbe a Spring.
app.${DOMINIO} {
    encode gzip
    root * /var/www/neurodesk

    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 5
            # A TEMPO, non solo a dimensione. Con poco traffico la sola soglia
            # sui megabyte avrebbe conservato mesi di log: e qui dentro le URI
            # contengono identificativi di risorsa (/api/companion-sessions/11),
            # cioe' la cronologia di quale conversazione e' stata riaperta e
            # quando. La conservazione E' la misura di privacy, non un dettaglio
            # operativo. Nell'archivio dell'honeypot quelle URI sono gia'
            # normalizzate; qui restano in chiaro, quindi scadono prima.
            roll_keep_for 336h
        }
        format json
    }

    header {
        Cache-Control "no-cache"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
        # script-src 'self' senza hash: nessuno script inline nell'app (tema e SW
        # sono file esterni/nel bundle), così un XSS iniettato non gira e non ruba
        # il token. 'unsafe-inline' resta solo sugli stili (React), rischio basso.
        Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }

    # Prima di tutto il resto: qui sotto c'e' il ripiego della single-page, che
    # rimanda QUALUNQUE percorso a index.html. Senza queste trappole davanti,
    # app.${DOMINIO} rispondeva 200 anche a /wp-admin e /.env — cioe' diceva
    # "trovato" a ogni scansione automatica, che e' il modo migliore per
    # sembrare un bersaglio interessante.
    import trappole

    handle /api/companion/* {
        reverse_proxy 127.0.0.1:8090
    }
    handle /api/internal/* {
        respond 404
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    # Frammenti di configurazione che vivono SOLO sul server (non nel repo): le
    # cose che non devono stare in chiaro in un repository pubblico. Se la
    # cartella e' vuota, Caddy importa il nulla senza errore.
    import /etc/caddy/conf.d/*.conf
    # Ripiego della single-page, ma SOLO sulle rotte che esistono davvero.
    #
    # Prima era "try_files {path} /index.html" su qualunque percorso: il sito
    # rispondeva 200 a tutto. Il 30 luglio 2026 uno scanner ha fatto 337
    # richieste e ne ha ricevute 137 con esito 200 — 128 volte la stessa pagina
    # da 511 byte. Non ha ottenuto niente, ma per 128 volte gli abbiamo
    # risposto "si, quel percorso esiste": e' il contrario del segnale che
    # serve dare.
    #
    # Questa e' una LISTA BIANCA e va tenuta allineata a App.jsx. Il costo di
    # dimenticare una rotta e' visibile subito (la pagina non si apre), quindi
    # e' un errore che si scopre, non uno che resta latente. L'opposto della
    # lista nera dei percorsi-trappola, dove una dimenticanza non si vede.
    #
    # /.well-known/* e' in lista bianca anche se la sfida ACME viaggia sulla
    # porta 80: non ho potuto dimostrare che il gestore ACME di Caddy preceda
    # il redirect verso https, e la documentazione ufficiale non lo afferma.
    # Tenerlo in lista bianca rende la domanda irrilevante — corretto in
    # entrambi i casi.
    # Le rotte sono elencate anche con lo slash finale: il matcher "path" di Caddy
    # e' esatto, quindi /login e /login/ sono due cose diverse e prima del
    # cambiamento funzionavano entrambe. Senza le varianti, un link con lo slash
    # finirebbe nel 404 e sembrerebbe un guasto.
    @rotteApp path / /login /login/ /consenso /consenso/ /companion /companion/ \
                   /feedback /feedback/ /codici /codici/ /moduli /moduli/ \
                   /moduli/nuovo /moduli/nuovo/ /task /task/ /task/nuovo /task/nuovo/
    handle @rotteApp {
        rewrite * /index.html
        file_server
    }
    handle /assets/* {
        file_server
    }


    # /.well-known ristretto a acme-challenge: il jolly rendeva invisibile un
    # intero spazio dei nomi, e una wordlist con quel prefisso sarebbe passata.
    @fileRadice path /favicon.svg /icons.svg /index.html /404.html /manifest.webmanifest /sw.js /theme-init.js /icon-192.png /icon-512.png /apple-touch-icon.png /maskable-512.png /.well-known/acme-challenge/*
    handle @fileRadice {
        file_server
    }
    # Tutto il resto non esiste. "error 404" invece di "respond 404" perche' cosi'
    # la richiesta passa a handle_errors, che serve una pagina leggibile MANTENENDO
    # lo stato 404: chi ha sbagliato a digitare capisce cosa fare, chi sta
    # scansionando non riceve nessuna conferma che il percorso esista.
    # Su uno strumento per persone neurodivergenti un errore muto e' un errore
    # di progetto.
    handle {
        error 404
    }
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
