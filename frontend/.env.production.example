# Copia in ".env.production" (gitignored) prima della build di produzione.
#
# URL pubblico del backend Spring. Due opzioni:
#  - Same-origin dietro reverse proxy (consigliato): lascia vuoto e fai instradare
#    al proxy /api/... verso il backend e /api/companion verso il companion.
#      VITE_API_BASE_URL=
#  - URL assoluto se il backend sta su un host/percorso diverso:
#      VITE_API_BASE_URL=https://neurodesk.example/api-backend
VITE_API_BASE_URL=
